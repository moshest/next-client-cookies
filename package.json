{
  "name": "next-client-cookies",
  "version": "2.1.3",
  "description": "SSR and client support for Next.js v13 cookies (app directory)",
  "keywords": [
    "next",
    "next.js",
    "nextjs",
    "cookies",
    "cookie",
    "js-cookie",
    "use",
    "client",
    "ssr",
    "server",
    "side",
    "side-rendering",
    "side-render",
    "auth",
    "authentication",
    "authenticating"
  ],
  "repository": "https://github.com/moshest/next-client-cookies.git",
  "author": "Moshe Simantov <me@moshe.io>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "require": "./dist/server.js",
      "import": "./dist/server.mjs",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "types": "rimraf --glob dist/*.{d.ts,d.ts.map} dist/**/*.{d.ts,d.ts.map} && tsc --emitDeclarationOnly && tsc-alias",
    "build": "rimraf --glob dist/*.{js,js.map,mjs,mjs.map} && tsup"
  },
  "peerDependencies": {
    "next": ">= 15.0.0",
    "react": ">= 16.8.0"
  },
  "devDependencies": {
    "@neuledge/eslint-config": "^1.1.1",
    "@neuledge/tsconfig": "^3.0.0",
    "@swc/core": "^1.16.18",
    "@types/js-cookie": "^3.0.3",
    "@types/node": "^20.4.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.46.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "next": "16.4.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^5.0.1",
    "tsc-alias": "^1.8.7",
    "tsup": "^8.5.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "js-cookie": "^3.0.7"
  },
  "pnpm": {
    "overrides": {
      "ajv@^6.0.0": "6.15.0",
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^2.0.0": "2.1.7",
      "browserslist": "4.29.3",
      "cross-spawn": "7.0.6",
      "flatted": "3.4.4",
      "glob@^10.0.0": "10.5.0",
      "js-yaml": "4.3.2",
      "micromatch": "4.0.8",
      "minimatch@^3.0.0": "3.1.5",
      "minimatch@^9.0.0": "9.0.9",
      "picomatch@^2.0.0": "2.3.2",
      "rollup": "4.64.6",
      "source-map-js": "1.2.2",
      "tsup@8.5.1>esbuild": "0.28.1",
      "yaml": "2.9.1"
    }
  }
}
